---
import Layout from '../layouts/Layout.astro';
import { categories, packages, faqs } from '../data/catalog';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import PackageCard from '../components/PackageCard.astro';
import Steps from '../components/Steps.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
---
<Layout title="Alquiler de parrillas y cilindros" description="Alquila parrillas, cilindros para cocinar y accesorios para tu reunión. Explora equipos y paquetes y solicita una cotización para tu evento.">
  <section class="hero home-hero container"><div class="hero-inner"><div class="hero-copy"><span class="eyebrow">Para reunir, compartir y disfrutar</span><h1>Alquiler de parrillas y cilindros para tus reuniones</h1><p class="hero-accent handwritten">Un momento especial</p><p>Haz de cada reunión un momento especial. Alquila parrillas, cilindros para cocinar y accesorios para tu próxima reunión.</p><div class="button-group"><Button href="/equipos/">Ver equipos</Button><Button href="/paquetes/" secondary arrow={false}>Ver paquetes</Button></div><p class="hero-footnote"><Icon name="message" size={16} />La disponibilidad y las condiciones se confirman al cotizar.</p></div><Photo image="hero" alt="Imagen conceptual de amigos compartiendo una parrilla en un jardín luminoso" class="hero-photo" eager caption sizes="(min-width: 768px) 600px, 100vw" /></div></section>
  <section class="section container" aria-labelledby="categorias"><div class="section-heading"><div><span class="eyebrow">Encuentra tu opción</span><h2 id="categorias">Cada reunión tiene su equipo</h2></div><a class="text-link" href="/equipos/">Ver todos los equipos<Icon name="arrow" size={18} /></a></div><div class="categories-grid">{categories.map(c => <a href={`/equipos/${c.slug}/`} class="category-card"><Photo image={c.image} alt={`Imagen ilustrativa de ${c.name.toLowerCase()}`} sizes="160px" /><div><h3>{c.name}</h3><p>{c.hint}</p></div><span class="round-arrow"><Icon name="arrow" size={16} /></span></a>)}</div></section>
  <section class="section container" aria-labelledby="paquetes"><div class="section-heading"><div><span class="eyebrow">Comparte a tu manera</span><h2 id="paquetes">Paquetes para cada ocasión</h2><p>Un punto de partida para organizar tu próxima reunión.</p></div><a class="text-link" href="/paquetes/">Explorar paquetes<Icon name="arrow" size={18} /></a></div><div class="grid-three package-grid">{packages.map(item => <PackageCard item={item} />)}</div></section>
  <section class="section container" aria-labelledby="pasos"><div class="section-heading"><div><span class="eyebrow">Así de sencillo</span><h2 id="pasos">De la idea a la parrilla</h2><p>Elige, consulta y coordina los detalles.</p></div><a class="text-link" href="/como-funciona/">Cómo funciona<Icon name="arrow" size={18} /></a></div><Steps /></section>
  <section class="section container" aria-labelledby="preguntas"><div class="section-heading"><h2 id="preguntas">Antes de encender la parrilla</h2><a class="text-link" href="/preguntas-frecuentes/">Todas las preguntas<Icon name="arrow" size={18} /></a></div><FAQ items={faqs.slice(1,5)} compact /><CTA /></section>
</Layout>
