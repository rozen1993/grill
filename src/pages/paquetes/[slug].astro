---
import Layout from '../../layouts/Layout.astro';
import { packages, equipment, faqs } from '../../data/catalog';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Gallery from '../../components/Gallery.astro';
import Photo from '../../components/Photo.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import FAQ from '../../components/FAQ.astro';
export function getStaticPaths() { return packages.map(item => ({params:{slug:item.slug},props:{item}})); }
const { item } = Astro.props;
const selected = equipment.filter(e => item.equipment.some(slug => slug === e.slug));
const url = `/cotizar/?paquete=${item.slug}`;
---
<Layout title={`Paquete ${item.name} para tu reunión`} description={item.detail} stickyCTA>
  <div class="container page-section"><Breadcrumbs items={[{label:'Paquetes',href:'/paquetes/'},{label:`Pack ${item.name}`}]} />
    <div class="detail-grid package-detail"><Gallery images={[{image:item.image,alt:`Imagen conceptual de la propuesta ${item.name}`,label:'Ver imagen de la propuesta'},...selected.map(e => ({image:e.image,alt:e.alt,label:`Ver imagen ilustrativa: ${e.name}`}))]} />
      <div class="detail-heading"><span class="eyebrow">Paquete propuesto</span><h1 class="desktop-detail-title">Pack {item.name}</h1><p>{item.detail}</p>
        <div class="detail-box"><h2>Una combinación para empezar</h2><p>Composición propuesta, sujeta a confirmación:</p><div class="included-grid">{selected.map(e => <div class="included-item"><Photo image={e.image} alt={e.alt} sizes="160px" /><h3>{e.name}</h3><a class="text-link" href={`/equipos/${e.slug}/`}>Ver equipo<Icon name="chevron" size={12} /></a></div>)}{item.slug === 'familiar' && <div class="included-item pending-item"><Icon name="info" size={28} /><h3>Mesa de apoyo</h3><p class="small">Por confirmar</p></div>}</div></div>
        <div class="detail-box"><h2>¿Necesitas algún complemento?</h2><p>Consulta entrega, recogida, carbón, limpieza o mobiliario en las observaciones. Su disponibilidad y costo se revisan por separado.</p></div>
        <div class="detail-box quote-detail-box"><div class="price-line"><strong>Por cotizar</strong><Icon name="message" size={22} /></div><p>La duración, el traslado y las condiciones se confirmarán en tu propuesta. La solicitud no confirma una reserva.</p><Button href={url}>Cotizar este paquete</Button></div>
      </div>
    </div><section class="spaced-section"><div class="section-heading"><h2>Antes de elegir tu paquete</h2></div><FAQ items={[faqs[2]!,faqs[4]!,faqs[3]!,faqs[1]!]} /></section><div class="button-group"><Button href="/paquetes/" secondary>Comparar otros paquetes</Button></div>
  </div><aside class="sticky-quote" aria-label="Cotizar paquete"><strong>Por cotizar</strong><Button href={url}>Cotizar este paquete</Button></aside>
</Layout>
