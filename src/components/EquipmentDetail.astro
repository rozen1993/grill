---
import Layout from '../layouts/Layout.astro';
import { categories, equipment, type Equipment } from '../data/catalog';
import Breadcrumbs from './Breadcrumbs.astro';
import Gallery from './Gallery.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import FAQ from './FAQ.astro';
import EquipmentCard from './EquipmentCard.astro';
const { item } = Astro.props as { item: Equipment };
const category = categories.find(c => c.slug === item.category)!;
const url = `/cotizar/?equipo=${item.slug}`;
---
<Layout title={`${item.name} en alquiler`} description={item.description} stickyCTA>
  <div class="container page-section"><Breadcrumbs items={[{label:'Equipos',href:'/equipos/'},{label:category.name,href:`/equipos/${category.slug}/`},{label:item.name}]} />
    <div class="detail-grid"><Gallery images={[{image:item.image,alt:item.alt,label:'Ver imagen del equipo'},{image:'hero',alt:'Imagen conceptual de una reunión con parrilla al aire libre',label:'Ver ambiente de reunión ilustrativo'}]} /><div class="detail-heading"><span class="eyebrow">{category.name}</span><h1 class="desktop-detail-title">{item.name}</h1><div class="tags"><span>{category.name}</span><span>{item.type}</span></div><p>{item.description}</p>
      <div class="detail-box"><h2>El equipo para tu idea</h2><p>Consulta estos detalles para elegir con tranquilidad:</p><ul class="check-list">{item.questions.map(q => <li><Icon name="check" size={18} />{q}</li>)}</ul></div>
      <div class="detail-box"><div class="price-line"><strong>Por cotizar</strong><Icon name="message" size={22} /></div><p>Cuéntanos la fecha y la zona de tu evento. La disponibilidad, los accesorios y las condiciones se confirmarán en la propuesta.</p><Button href={url}>Cotizar este equipo</Button><p class="small mt-4">La solicitud no confirma una reserva.</p></div>
    </div></div>
    <section class="spaced-section"><div class="section-heading"><h2>Los detalles también cuentan</h2></div><FAQ items={[
      {question:'¿Qué acompaña el alquiler?',answer:'La composición se confirma al cotizar. Consulta los utensilios y accesorios del equipo elegido antes de reservar.'},
      {question:'Complementos y traslado',answer:'El carbón, la limpieza, la entrega, la recogida y el mobiliario se consultan por separado. No se asumen incluidos en el alquiler.'},
      {question:'Condiciones de alquiler',answer:'Confirma la duración, el costo total, la garantía si corresponde y las condiciones de uso y devolución antes de acordar una reserva.'},
    ]} /></section>
    <section class="spaced-section"><div class="section-heading"><h2>También te puede interesar</h2><a class="text-link" href="/equipos/">Explorar el catálogo<Icon name="arrow" size={18} /></a></div><div class="grid-three">{equipment.filter(e => e.slug !== item.slug).map(e => <EquipmentCard item={e} />)}</div></section>
  </div><aside class="sticky-quote" aria-label="Cotizar equipo"><strong>Por cotizar</strong><Button href={url}>Cotizar este equipo</Button></aside>
</Layout>
