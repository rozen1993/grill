---
import Icon from './Icon.astro';
interface Props { items: { label: string; href?: string }[]; }
const { items } = Astro.props;
---
<nav aria-label="Ruta de navegación" class="breadcrumbs"><ol><li><a href="/">Inicio</a></li>{items.map(item => <li><Icon name="chevron" size={14} />{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}</ol></nav>
